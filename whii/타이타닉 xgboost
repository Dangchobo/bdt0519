#예측 및 평가지표(성과측정)
y_pred = model.predict(X_val) #검증데이터 x_val에 대한 생존여부 예측

acc = accuracy_score(y_val, y_pred) #정답레이블,예측값을 비교해서 정확도 계산
f1 = f1_score(y_val, y_pred)#F1 Score는 정밀도(Precision)와 재현율(Recall)의 조화 평균 
#불균형한 데이터셋(예: 생존자가 적은 경우)에 더 유용한 지표
#공식: 2 * (Precision * Recall) / (Precision + Recall)

print(f"✅ Accuracy: {acc:.4f}")
#소수점 4자리까지 출력
print(f"✅ F1 Score: {f1:.4f}")
✅ Accuracy: 0.8268
✅ F1 Score: 0.7737
# Confusion Matrix 시각화
cm = confusion_matrix(y_val, y_pred) #matrix생성
disp = ConfusionMatrixDisplay(confusion_matrix=cm)
disp.plot()
plt.title("Confusion Matrix")
plt.show()

#149명은 맞추조 나머지는 틀림
#모델이 어떤 실수를 하는지 알기 위해 이 매트릭스를 사용

# Feature Importance 시각화
# 각 피쳐가 얼마나 기여도가 있는지 시각화
plot_importance(model)
plt.title("Feature Importance")
plt.show()

# 예: max_depth를 5로 바꾸고 실험
model2 = XGBClassifier(n_estimators=100, max_depth=5, learning_rate=0.1, eval_metric='logloss')
model2.fit(X_train, y_train)
y_pred2 = model2.predict(X_val)
print(f"max_depth=5 → Accuracy: {accuracy_score(y_val, y_pred2):.4f}, F1: {f1_score(y_val, y_pred2):.4f}")
